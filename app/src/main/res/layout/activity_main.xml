<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Section: Team Names and Sets Won -->
    <TextView
        android:id="@+id/textview_team_a_sets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Team A Sets: 0"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/textview_team_b_sets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5" />

    <TextView
        android:id="@+id/textview_team_b_sets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Team B Sets: 0"
        android:textAlignment="textEnd"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textview_team_a_sets"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5" />


    <!-- Middle Section: Scoreboard -->
    <LinearLayout
        android:id="@+id/scoreboard_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_team_a_sets">

        <!-- Team A Score -->
        <LinearLayout
            android:id="@+id/team_a_score_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#B84023"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_team_a_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="120sp"
                tools:text="0" />

        </LinearLayout>

        <!-- Team B Score -->
        <LinearLayout
            android:id="@+id/team_b_score_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0191A0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_team_b_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="120sp"
                tools:text="0" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/button_undo"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:text="@string/undo"
        app:icon="@drawable/undo"
        app:iconGravity="start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_team_a_sets" />

    <Button
        android:id="@+id/button_redo"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:text="@string/redo"
        app:icon="@drawable/redo"
        app:iconGravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_team_a_sets" />

    <!-- Bottom Section: Reset Buttons -->
    <LinearLayout
        android:id="@+id/reset_buttons_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/button_reset_set"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/reset_set" />

        <Button
            android:id="@+id/button_reset_match"
            style="?android:attr/buttonBarStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/reset_match" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
