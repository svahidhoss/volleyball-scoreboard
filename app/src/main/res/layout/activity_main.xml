<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait: Team A on top, Team B below. Landscape puts them side by side (layout-land/). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scoreboard: fills the whole screen, behind the system bars (edge-to-edge).
         Declared first so the labels and buttons below draw on top of it. -->
    <LinearLayout
        android:id="@+id/scoreboard_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Team A Score -->
        <LinearLayout
            android:id="@+id/team_a_score_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#B84023"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_team_a_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="120sp"
                tools:text="0" />

        </LinearLayout>

        <!-- Team B Score -->
        <LinearLayout
            android:id="@+id/team_b_score_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0191A0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_team_b_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="120sp"
                tools:text="0" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom edge of the status bar; set in code from the window insets -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <!-- Where Team A's half ends and Team B's begins -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Top Section: Undo / Redo and the winner message -->
    <Button
        android:id="@+id/button_undo"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:text="@string/undo"
        app:icon="@drawable/undo"
        app:iconGravity="start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top" />

    <Button
        android:id="@+id/button_redo"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_weight="1"
        android:text="@string/redo"
        app:icon="@drawable/redo"
        app:iconGravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top" />

    <TextView
        android:id="@+id/textview_winner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        tools:text="Winner:\nTeam A!"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/button_redo"
        app:layout_constraintStart_toEndOf="@+id/button_undo"
        app:layout_constraintTop_toBottomOf="@+id/guideline_top"
        tools:visibility="visible" />

    <!-- Below whichever is taller: the buttons, or the winner message when it's shown -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="button_undo,button_redo,textview_winner" />

    <!-- Each team's sets, inside its own half -->
    <TextView
        android:id="@+id/textview_team_a_sets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Team A Sets: 0"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_top_controls" />

    <TextView
        android:id="@+id/textview_team_b_sets"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Team B Sets: 0"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline_middle" />

    <!-- Splits the reset buttons evenly across the screen -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Bottom Section: Reset Buttons (outer and bottom margins for the system bars are set in code) -->
    <Button
        android:id="@+id/button_reset_set"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="@string/reset_set"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_center"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button_reset_match"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="@string/reset_match"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_center" />

</androidx.constraintlayout.widget.ConstraintLayout>
